# Copy to .env (not committed) and set your values.

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# hreflang alternates, link previews and the generated sitemap.xml.
# Without it, pre-rendering and the sitemap are skipped.
VITE_SITE_URL=https://example.com

# Publishing with npm run deploy (SSH key login). The site is served from
# DEPLOY_PATH/current; point nginx root there.
DEPLOY_HOST=user@your-server
DEPLOY_PATH=/var/www/myzine
# DEPLOY_PORT=22
# DEPLOY_KEEP=5
